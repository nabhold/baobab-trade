NODE_ENV=development
PORT=9000
LOG_LEVEL=info
DATABASE_URL=postgres://baobab_trade:baobab_trade@postgres:5432/baobab_trade
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-secret-manager
COOKIE_SECRET=change-me-in-secret-manager
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7001,http://localhost:9000
BAOBAB_TRADE_ENGINE_ID=baobab-trade-local
BAOBAB_CONTROL_PLANE_BASE_URL=http://host.docker.internal:8080
BAOBAB_CONTROL_PLANE_CONTEXT_PATH=/v1/context/resolve
BAOBAB_CONTROL_PLANE_MARKET_PATH_TEMPLATE=/v1/markets/{market_id}
BAOBAB_CONTROL_PLANE_PRODUCT_ID=baobab-trade
BAOBAB_ERP_API_BASE_URL=http://host.docker.internal:8000
BAOBAB_PULSE_API_BASE_URL=http://host.docker.internal:8100
BAOBAB_WEBHOOK_SIGNING_SECRET=change-me
