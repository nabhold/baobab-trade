{
  "name": "@nabhold/baobab-trade",
  "version": "0.2.0",
  "private": true,
  "description": "Baobab Trade Engine - independently deployable MedusaJS commerce engine for the Baobab Platform.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "migrate": "medusa db:migrate",
    "migrate:search": "medusa db:migrate:search",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "bootstrap:market": "medusa exec ./src/scripts/bootstrap-market.ts",
    "bootstrap:catalogue": "medusa exec ./src/scripts/bootstrap-catalogue.ts",
    "bootstrap:inventory": "medusa exec ./src/scripts/bootstrap-inventory.ts",
    "bootstrap:payments": "medusa exec ./src/scripts/bootstrap-payments.ts",
    "bootstrap:fulfilment": "medusa exec ./src/scripts/bootstrap-fulfilment.ts",
    "bootstrap:thamani-market": "medusa exec ./src/scripts/bootstrap-thamani-market.ts",
    "bootstrap:thamani-catalogue": "medusa exec ./src/scripts/bootstrap-thamani-catalogue.ts",
    "bootstrap:tax": "medusa exec ./src/scripts/bootstrap-tax.ts",
    "bootstrap:trade-readiness": "medusa exec ./src/scripts/bootstrap-trade-readiness.ts",
    "bootstrap:erp-integration": "medusa exec ./src/scripts/bootstrap-erp-integration.ts",
    "bootstrap:thamani-search": "medusa exec ./src/scripts/bootstrap-thamani-search.ts",
    "verify:market-projections": "medusa exec ./src/scripts/verify-market-projections.ts",
    "verify:b2b-module": "medusa exec ./src/scripts/verify-b2b-module.ts",
    "verify:catalogue": "medusa exec ./src/scripts/verify-catalogue.ts",
    "verify:inventory": "medusa exec ./src/scripts/verify-inventory.ts",
    "verify:payments": "medusa exec ./src/scripts/verify-payments.ts",
    "verify:fulfilment": "medusa exec ./src/scripts/verify-fulfilment.ts",
    "verify:thamani-market": "medusa exec ./src/scripts/verify-thamani-market.ts",
    "verify:thamani-catalogue": "medusa exec ./src/scripts/verify-thamani-catalogue.ts",
    "verify:tax": "medusa exec ./src/scripts/verify-tax.ts",
    "verify:trade-readiness": "medusa exec ./src/scripts/verify-trade-readiness.ts",
    "verify:erp-integration": "medusa exec ./src/scripts/verify-erp-integration.ts",
    "verify:thamani-search": "medusa exec ./src/scripts/verify-thamani-search.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/tenant-context.test.ts tests/canonical-mapping-contract.test.ts tests/control-plane-client.test.ts",
    "test:isolation": "vitest run tests/commerce-context.test.ts",
    "test:watch": "vitest",
    "verify:core-modules": "medusa exec ./src/scripts/verify-core-modules.ts",
    "verify:infrastructure": "medusa exec ./src/scripts/verify-infrastructure.ts"
  },
  "dependencies": {
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@medusajs/utils": "2.20.1",
    "awilix": "8.0.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@types/node": "20.17.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
